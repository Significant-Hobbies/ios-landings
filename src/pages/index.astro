---
import Cta from "../components/Cta.astro";
import Phone from "../components/Phone.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { site } from "../site.config";
import "../styles/landing.css";

const illustration = site.illustration;
---
<SiteLayout>
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="hero-kicker">{site.kicker}</p>
        <h1><span class="sr-only">{site.name}: </span>{site.headline[0]}<br />{site.headline[1]}</h1>
        <p class="hero-lede">{site.lede}</p>
        <div class="hero-actions">
          <Cta />
          <a class="text-link" href="#look-inside">See the real app <span aria-hidden="true">↓</span></a>
        </div>
        <p class="hero-meta">{site.status}<br />{site.platforms.join(" · ")}</p>
      </div>
      <div class:list={["hero-stage", illustration && "has-illustration"]}>
        {illustration ? <img class="hero-doodle" src={illustration.src} alt={illustration.alt} /> : <span class="stage-label" aria-hidden="true">Real product screen</span>}
        <Phone
          src={site.hero.image}
          alt={site.hero.alt}
          size="hero"
          tilt="right"
          priority
        />
        <p class="stage-note">{site.hero.caption}</p>
      </div>
    </div>
    <div class="shell proof-rail" aria-label="Product overview">
      {site.chapters.slice(0, 3).map((chapter, index) => (
        <div class="proof-item">
          <span aria-hidden="true">0{index + 1}</span>
          <p><strong>{chapter.name}</strong>{chapter.title}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="look-inside" class="gallery" aria-labelledby="gallery-title">
    <div class="shell gallery-head">
      <p class="chapter-kicker">Look inside</p>
      <h2 id="gallery-title">No mockups.<br />The real product.</h2>
      <p>{site.betaNote}</p>
    </div>
    <div class="shell gallery-grid">
      {site.gallery.map((shot) => (
        <Phone src={shot.src} alt={shot.alt} size="gallery" />
      ))}
    </div>
  </section>

  <section class="tension shell" aria-labelledby="tension-title">
    <p class="statement"><span>{site.tension.statement}</span></p>
    <div class="tension-copy">
      <h2 id="tension-title">{site.tension.title}</h2>
      <p>{site.tension.copy}</p>
    </div>
  </section>

  <section id="how-it-works" class="chapters" aria-labelledby="chapters-title">
    <div class="shell chapter-intro">
      <div>
        <p class="chapter-kicker">{site.chaptersKicker}</p>
        <h2 id="chapters-title">{site.chaptersTitle}</h2>
      </div>
      <p>{site.chaptersLede}</p>
    </div>
    {site.chapters.map((chapter, index) => (
      <article class:list={["chapter", index % 2 === 1 && "chapter-reverse"]}>
        <div class="shell chapter-grid">
          <div class="chapter-copy">
            <p class="chapter-name">{chapter.name}</p>
            <h3>{chapter.title}</h3>
            <p>{chapter.copy}</p>
          </div>
          <Phone
            src={chapter.image}
            alt={chapter.alt}
            size="chapter"
            tilt={index % 2 === 1 ? "right" : "left"}
            priority={index === 0}
          />
        </div>
      </article>
    ))}
  </section>

  <section class="fit-section">
    <div class="shell fit-grid">
      <div>
        <p class="chapter-kicker">{site.fit.kicker}</p>
        <h2>{site.fit.title}</h2>
      </div>
      <div class="fit-copy">
        <p><strong class="fit-label">A fit</strong> {site.fit.yes}</p>
        <p><strong class="fit-label">Not a fit</strong> {site.fit.no}</p>
      </div>
    </div>
  </section>

  <section id="privacy" class="privacy-section" aria-labelledby="privacy-title">
    <div class="shell privacy-grid">
      <div class="privacy-mark" aria-hidden="true">
        <img src={site.mark} width="660" height="660" alt="" loading="lazy" decoding="async" />
      </div>
      <div>
        <p class="chapter-kicker">{site.privacy.kicker}</p>
        <h2 id="privacy-title">{site.privacy.title}</h2>
        <p>{site.privacy.copy}</p>
        <a class="text-link" href="/privacy/">Read the plain-language privacy policy <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="faq shell" aria-labelledby="faq-title">
    <h2 id="faq-title">A few honest answers.</h2>
    <div class="faq-list">
      {site.faqs.map((faq) => (
        <details>
          <summary>{faq.question}</summary>
          <p>{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="founder-note">
    <div class="shell founder-grid">
      <blockquote>“{site.founder.quote}”</blockquote>
      <div>
        <p>{site.founder.credit}</p>
        <p>{site.founder.note}</p>
      </div>
    </div>
  </section>

  <section class="closing">
    <div class="shell">
      <h2>{site.closingTitle[0]}<br />{site.closingTitle[1]}</h2>
      <Cta />
    </div>
  </section>
</SiteLayout>
