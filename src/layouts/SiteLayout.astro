---
import "../styles/global.css";
import { clarityProjectIdFor } from "../lib/clarity";
import { appHealthConfigFor } from "../lib/app-health.mjs";
import { primaryCta, verifiedAppStoreUrl } from "../lib/distribution";
import { links, productId, site } from "../site.config";
import { getPublishedPosts } from "../lib/blog";
import { actionColors } from "../lib/contrast.mjs";
import { screenshotMetadata } from "../lib/screenshot-metadata.mjs";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  image?: string;
  robots?: string;
  markdownAlternatePath?: string;
  includeStructuredData?: boolean;
}

const productTitle = `${site.name} — ${site.tagline}`;
const conciseProductTitle = `${site.name} — ${site.headline.join(" ")}`;
const {
  title = productTitle.length <= 60 ? productTitle : conciseProductTitle,
  description = site.seoDescription ?? site.lede,
  canonicalPath = "/",
  image = site.socialImage,
  robots = "index,follow",
  markdownAlternatePath,
  includeStructuredData = true
} = Astro.props;
const canonical = new URL(canonicalPath, Astro.site);
const markdownPath = markdownAlternatePath ?? (canonicalPath === "/" ? "/index.md" : `${canonicalPath}index.md`);
const markdownAlternate = new URL(markdownPath, Astro.site);
const socialImage = new URL(image, Astro.site);
const socialDimensions = image.startsWith("/images/") ? await screenshotMetadata(productId, image) : { width: 1200, height: 630 };
const cta = primaryCta();
const storeUrl = verifiedAppStoreUrl();
const t = site.tokens;
const action = actionColors(t);
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      name: "Significant Hobbies",
      url: "https://significanthobbies.com"
    },
    {
      "@type": "WebSite",
      name: site.name,
      url: site.url,
      description: site.summary,
      image: new URL(site.socialImage, site.url).href
    },
    ...(canonicalPath === "/" ? [{
      "@type": "FAQPage",
      mainEntity: site.faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: { "@type": "Answer", text: faq.answer }
      }))
    }] : [])
  ]
};
const tokenStyle = [
  `--button-bg:${action.background}`,
  `--button-fg:${action.foreground}`,
  `--button-hover-bg:${action.hoverBackground}`,
  `--button-hover-fg:${action.hoverForeground}`,
  `--site-paper:${t.paper}`,
  `--site-field:${t.field}`,
  `--site-ink:${t.ink}`,
  `--site-ink-soft:${t.inkSoft}`,
  `--site-ink-faint:${t.inkFaint}`,
  `--site-accent:${t.accent}`,
  `--site-accent-dark:${t.accentDark}`,
  `--site-accent-soft:${t.accentSoft}`,
  `--site-lantern-a:${t.lanternA}`,
  `--site-lantern-b:${t.lanternB}`,
  `--site-lantern-c:${t.lanternC}`,
  `--site-blush:${t.blush}`,
  `--site-ink-on-dark:${t.inkOnDark}`,
  `--site-ink-on-accent:${t.inkOnAccent ?? "#ffffff"}`
].join(";");
const scheme = site.colorScheme ?? "light";
const portfolioProjectId = productId === "habits" ? "indulge" : productId;
const isHistoricalSuccessor = productId === "indulge" || productId === "habits";
const footerArtId = isHistoricalSuccessor ? "anchor" : portfolioProjectId;
const privateFooterArt: Record<string, { alt: string; width: number; height: number; credit: string; focalX: number; focalY: number }> = {
  "journal": {
    "alt": "Journal: A private evening writing ritual centers an open blank notebook under a lamp beside a lavender window. Closed previous volumes, tea and a quiet shelf imply a local archive without displaying entries.",
    "width": 2169,
    "height": 725,
    "credit": "Original illustration for Journal",
    "focalX": 50,
    "focalY": 50
  },
  "motion": {
    "alt": "Motion: A fictional living-room prototype groups a phone facing a simple human silhouette with a television showing an abstract game path. A short bounded local-sensing line joins the phone and figure; furniture stays quiet.",
    "width": 2172,
    "height": 724,
    "credit": "Original illustration for Motion",
    "focalX": 50,
    "focalY": 50
  }
};
const footerArtwork = isHistoricalSuccessor ? {
  alt: "Anchor: A day-planning terrace centers the crossing between a planned stepping-stone path and a real-life detour. A pause bench, simple clock, task tokens and end-of-day notebook make interruptions ordinary. Indulge and Habits remain historical identities; their maintained successor is Anchor.",
  width: 2171,
  height: 724,
  credit: "Original illustration for Anchor, the maintained successor to Indulge and Habits",
  focalX: 50,
  focalY: 50
} : privateFooterArt[footerArtId];
const footerArtSrc = privateFooterArt[footerArtId]
  ? `/footer-art/${footerArtId}.webp`
  : `https://sassmaker.com/footer-art/${footerArtId}.webp`;
const clarityProjectId = clarityProjectIdFor(productId);
const appHealth = appHealthConfigFor(productId);
const newsletterCapture = site.newsletterCapture === true;
const newsletterTheme = scheme;
const hasBlog = (await getPublishedPosts()).length > 0;
---
<!doctype html>
<html lang="en" data-product={productId} data-device={site.device ?? "phone"} data-scheme={scheme} style={tokenStyle}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content={site.themeColor} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="text/markdown" href={markdownAlternate} />
    {hasBlog && <link rel="alternate" type="application/rss+xml" title={`${site.name} journal`} href="/blog/rss.xml" />}
    {site.device === "desktop" ? <link rel="icon" type="image/png" href={site.mark} /> : <>
      <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
      <link rel="icon" type="image/png" sizes="64x64" href="/favicon-64.png" />
    </>}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content={String(socialDimensions.width)} />
    <meta property="og:image:height" content={String(socialDimensions.height)} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="robots" content={robots} />
    {site.appStoreId && storeUrl ? (
      <meta name="apple-itunes-app" content={`app-id=${site.appStoreId}`} />
    ) : null}
    {includeStructuredData ? (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    ) : null}
    {clarityProjectId ? (
      <script is:inline define:vars={{ clarityProjectId, productId }}>
        (function(c, l, a, r, i, t, y) {
          c[a] = c[a] || function() { (c[a].q = c[a].q || []).push(arguments); };
          t = l.createElement(r);
          t.async = 1;
          t.src = "https://www.clarity.ms/tag/" + i;
          y = l.getElementsByTagName(r)[0];
          y.parentNode.insertBefore(t, y);
        })(window, document, "clarity", "script", clarityProjectId);
        window.clarity("set", "project_id", productId);
      </script>
    ) : null}
    {appHealth ? (
      <script is:inline define:vars={{ productId, macDownloadUrl: site.macDownloadUrl ?? "", repositoryUrl: links.repository ?? "" }}>
        const trackAppHealthEvent = (name, afterFlush) => {
          let continued = false;
          let navigationTimer;
          const continueOnce = () => {
            if (continued) return;
            continued = true;
            if (navigationTimer !== undefined) window.clearTimeout(navigationTimer);
            afterFlush?.();
          };
          const send = () => {
            const tracker = window.appHealth;
            if (!tracker || typeof tracker.track !== "function") {
              continueOnce();
              return;
            }
            tracker.track(name);
            if (afterFlush && typeof tracker.flush === "function") {
              void tracker.flush().catch(() => {}).finally(continueOnce);
            } else {
              continueOnce();
            }
          };
          if (window.appHealth && typeof window.appHealth.track === "function") {
            send();
          } else {
            const trackerScript = document.getElementById("app-health-tracker");
            if (!trackerScript) {
              continueOnce();
              return;
            }
            trackerScript.addEventListener("load", send, { once: true });
            trackerScript.addEventListener("error", continueOnce, { once: true });
          }
          if (afterFlush && !continued) navigationTimer = window.setTimeout(continueOnce, 3000);
        };
        document.addEventListener("click", (event) => {
          const path = event.composedPath();
          const link = path.find((target) => target instanceof HTMLAnchorElement);
          const href = link?.getAttribute("href");
          let ctaEvent;
          if (href === "/testflight/" && ["anchor", "kith", "motion", "setline"].includes(productId)) {
            ctaEvent = "testflight_status_opened";
          } else if (href === "/#how-it-works" && productId !== "setline") {
            ctaEvent = "how_it_works_opened";
          } else if (href === "#look-inside" && productId === "setline") {
            ctaEvent = "product_preview_opened";
          } else if (productId === "anchor" && macDownloadUrl && href === macDownloadUrl) {
            ctaEvent = "mac_beta_downloaded";
          } else if (productId === "browserdaddy" && href === "/release/") {
            ctaEvent = "release_status_opened";
          } else if (productId === "performancedaddy" && repositoryUrl && href === repositoryUrl) {
            ctaEvent = "source_opened";
          } else if (productId === "contextdaddy" && macDownloadUrl && href === macDownloadUrl) {
            ctaEvent = "download_opened";
          } else if (productId === "contextdaddy" && href === "/release/") {
            ctaEvent = "release_details_opened";
          } else if (["browserdaddy", "performancedaddy"].includes(productId) && macDownloadUrl && href === macDownloadUrl) {
            ctaEvent = "mac_download_clicked";
          }
          const delayNavigation = ctaEvent && link && event.button === 0 &&
            !event.metaKey && !event.ctrlKey && !event.shiftKey && !event.altKey &&
            (!link.target || link.target === "_self") && link.origin === window.location.origin;
          if (delayNavigation) {
            event.preventDefault();
            trackAppHealthEvent(ctaEvent, () => window.location.assign(link.href));
          } else if (ctaEvent) {
            trackAppHealthEvent(ctaEvent);
          }
          const newsletterSubmit = path.some((target) =>
            target instanceof HTMLButtonElement && target.type === "submit"
          );
          const newsletterHost = path.find((target) =>
            target instanceof Element && target.localName === "saas-maker-newsletter-capture"
          );
          const consent = newsletterHost?.shadowRoot?.querySelector("input[name='consent']");
          const email = newsletterHost?.shadowRoot?.querySelector("input[type='email']");
          if (newsletterSubmit && consent?.checked && email?.validity.valid) {
            trackAppHealthEvent("newsletter_signup_clicked");
          }
        });
      </script>
    ) : null}
    {appHealth ? (
      <script
        is:inline
        id="app-health-tracker"
        defer
        src="https://health.sassmaker.com/tracker.js"
        data-key={appHealth.publicKey}
        data-project={appHealth.projectId}
        data-identity="persistent"
        data-endpoint="https://ingest.sassmaker.com/v1/browser"
      />
    ) : null}
    {/* Cache-qualified module for Anchor catalog auto-capture; does not create a native form. */}
    {newsletterCapture || productId === "anchor" ? (
      <script is:inline type="module" src="https://sassmaker.com/newsletter-capture.js?v=precise-b0adaa67"></script>
    ) : null}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header">
      <div class="shell">
        <a class="wordmark" href="/" aria-label={`${site.name} home`}>
          <img src={site.mark} width="38" height="38" alt="" />
          <span>{site.name}</span>
        </a>
        <nav class="nav-links" aria-label="Primary navigation">
          <a href="/#how-it-works">How it works</a>
          <a href="/#privacy">Privacy</a>
          {hasBlog && <a href="/blog/">Journal</a>}
          <a class="header-beta" href={cta.href}>{cta.kind === "status" ? (site.device === "desktop" ? "Release status" : "Beta status") : cta.label}</a>
        </nav>
      </div>
    </header>
    <main id="content"><slot /></main>
    <fleet-footer-extension style={productId === "performancedaddy" ? "--fleet-footer-mobile-signature-size:clamp(1.625rem,8.6vw,2.15rem);--fleet-footer-app-mobile-signature-size:clamp(1.625rem,8.2vw,2rem)" : undefined} class="precise-footer" product-name={site.name} signature-name={site.name} font-base="https://sassmaker.com/fonts/fleet-footer-precise-v1/" surface={canonicalPath === "/" ? "landing" : "app"} art-src={footerArtSrc} art-alt={footerArtwork?.alt} art-width={footerArtwork?.width} art-height={footerArtwork?.height} art-credit={footerArtwork?.credit} art-position={footerArtwork ? `${footerArtwork.focalX}% ${footerArtwork.focalY}%` : undefined} theme={scheme}>
      {Astro.slots.has("footer-cta") && <div slot="cta" data-fleet-footer-cta><slot name="footer-cta" /></div>}
      {newsletterCapture ? (
          <section slot="capture" class="footer-newsletter" aria-label={`${site.name} email updates`}>
            <saas-maker-newsletter-capture
              product-name={site.name}
              catalog-id={productId}
              kind="newsletter"
              source="footer"
              privacy-url={links.privacy}
              theme={newsletterTheme}
              layout="compact"
              integrated
              data-clarity-mask="true"
            ></saas-maker-newsletter-capture>
          </section>
        ) : null}
      <footer slot="navigation" data-fleet-footer-navigation class="site-footer precise-navigation">
        <p class="footer-identity"><a href="/"><img src={site.mark} width="24" height="24" alt="" loading="lazy" decoding="async" />{site.name}</a></p>
        <nav class="precise-routes" aria-label={`${site.name} footer navigation`}>
          <div class="footer-route-group">
            <h2 data-fleet-footer-group-label>Explore</h2>
            <a href="/" data-fleet-footer-primary>Overview</a>
            {site.device === "desktop" ? (
              <a href="/release/" data-fleet-footer-primary>Release status</a>
            ) : cta.kind === "web-app" || cta.kind === "successor" ? (
              <a href={cta.href} data-fleet-footer-primary>{cta.label}</a>
            ) : (
              <a href="/testflight/" data-fleet-footer-primary>TestFlight</a>
            )}
            {hasBlog && <a href="/blog/">Journal</a>}
          </div>
          <div class="footer-route-group">
            <h2 data-fleet-footer-group-label>Resources</h2>
            <a href="/privacy/">Privacy</a>
            <a href="/terms/">Terms</a>
            <a href="/accessibility/">Accessibility</a>
          </div>
          <div class="footer-route-group footer-route-contact">
            <h2 data-fleet-footer-group-label>Connect</h2>
            <a href="/support/">Support</a>
            {links.repository && <a href={links.repository} aria-label={`${site.name} source code on GitHub`} target="_blank" rel="noopener noreferrer">Source code ↗</a>}
          </div>
        </nav>
        <p class="fine-print footer-legal" data-fleet-footer-legal>{site.footerFinePrint}</p>
      </footer>
    </fleet-footer-extension>
    <script
      is:inline
      src="https://sassmaker.com/project-strip.js?v=precise-b0adaa67"
      data-project={portfolioProjectId}
      data-theme={scheme}
      defer
    ></script>
    <script
      is:inline
      src="https://sassmaker.com/ai-chat-footer.js?v=precise-b0adaa67"
      data-name={site.name}
      data-theme={scheme}
      defer
    ></script>
  </body>
</html>
