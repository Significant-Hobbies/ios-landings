---
import "../styles/global.css";
import { primaryCta, verifiedAppStoreUrl } from "../lib/distribution";
import { productId, site } from "../site.config";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  image?: string;
  robots?: string;
  markdownAlternatePath?: string;
  includeStructuredData?: boolean;
}

const productTitle = `${site.name} — ${site.tagline}`;
const conciseProductTitle = `${site.name} — ${site.headline.join(" ")}`;
const {
  title = productTitle.length <= 60 ? productTitle : conciseProductTitle,
  description = site.lede,
  canonicalPath = "/",
  image = site.socialImage,
  robots = "index,follow",
  markdownAlternatePath,
  includeStructuredData = true
} = Astro.props;
const canonical = new URL(canonicalPath, Astro.site);
const markdownPath = markdownAlternatePath ?? (canonicalPath === "/" ? "/index.md" : `${canonicalPath}index.md`);
const markdownAlternate = new URL(markdownPath, Astro.site);
const socialImage = new URL(image, Astro.site);
const cta = primaryCta();
const storeUrl = verifiedAppStoreUrl();
const t = site.tokens;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      name: "Significant Hobbies",
      url: "https://significanthobbies.com"
    },
    {
      "@type": "SoftwareApplication",
      name: site.name,
      url: site.url,
      applicationCategory: site.applicationCategory,
      operatingSystem: site.platforms.join(", "),
      description: site.summary,
      image: new URL(site.socialImage, site.url).href,
      screenshot: site.gallery.map((shot) => new URL(shot.src, site.url).href)
    },
    {
      "@type": "FAQPage",
      mainEntity: site.faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: { "@type": "Answer", text: faq.answer }
      }))
    }
  ]
};
const tokenStyle = [
  `--site-paper:${t.paper}`,
  `--site-field:${t.field}`,
  `--site-ink:${t.ink}`,
  `--site-ink-soft:${t.inkSoft}`,
  `--site-ink-faint:${t.inkFaint}`,
  `--site-accent:${t.accent}`,
  `--site-accent-dark:${t.accentDark}`,
  `--site-accent-soft:${t.accentSoft}`,
  `--site-lantern-a:${t.lanternA}`,
  `--site-lantern-b:${t.lanternB}`,
  `--site-lantern-c:${t.lanternC}`,
  `--site-blush:${t.blush}`,
  `--site-ink-on-dark:${t.inkOnDark}`,
  `--site-ink-on-accent:${t.inkOnAccent ?? "#ffffff"}`
].join(";");
const scheme = site.colorScheme ?? "light";
const portfolioProjectId = productId === "habits" ? "indulge" : productId;
---
<!doctype html>
<html lang="en" data-product={productId} data-scheme={scheme} style={tokenStyle}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content={site.themeColor} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="text/markdown" href={markdownAlternate} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon-64.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="robots" content={robots} />
    {site.appStoreId && storeUrl ? (
      <meta name="apple-itunes-app" content={`app-id=${site.appStoreId}`} />
    ) : null}
    {includeStructuredData ? (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    ) : null}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header">
      <div class="shell">
        <a class="wordmark" href="/" aria-label={`${site.name} home`}>
          <img src={site.mark} width="38" height="38" alt="" />
          <span>{site.name}</span>
        </a>
        <nav class="nav-links" aria-label="Primary navigation">
          <a href="/#how-it-works">How it works</a>
          <a href="/#privacy">Privacy</a>
          <a class="header-beta" href={cta.href}>{cta.kind === "status" ? "Beta status" : cta.label}</a>
        </nav>
      </div>
    </header>
    <main id="content"><slot /></main>
    <footer class="site-footer">
      <div class="shell">
        <div>
          <a class="wordmark" href="/">
            <img src={site.mark} width="38" height="38" alt="" loading="lazy" decoding="async" />
            <span>{site.name}</span>
          </a>
          <p class="fine-print" style="margin-top: 14px">{site.footerFinePrint}</p>
        </div>
        <nav class="footer-links" aria-label="Footer navigation">
          <a href="/privacy/">Privacy</a>
          <a href="/support/">Support</a>
          <a href="/terms/">Terms</a>
          <a href="/accessibility/">Accessibility</a>
          {cta.kind === "web-app" || cta.kind === "successor" ? (
            <a href={cta.href}>{cta.label}</a>
          ) : (
            <a href="/testflight/">TestFlight</a>
          )}
        </nav>
      </div>
    </footer>
    <script
      is:inline
      src="https://sassmaker.com/project-strip.js"
      data-project={portfolioProjectId}
      defer
    ></script>
    <script
      is:inline
      src="https://sassmaker.com/ai-chat-footer.js"
      data-name={site.name}
      data-compose="false"
      defer
    ></script>
  </body>
</html>
