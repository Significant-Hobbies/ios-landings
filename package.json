    "preview": "astro preview"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "astro": "7.2.0",
    "lightningcss": "1.33.0",
    "typescript": "6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
