{
  "name": "ios-landings",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "astro dev",
    "dev:kith": "PRODUCT=kith astro dev",
    "dev:setline": "PRODUCT=setline astro dev",
    "dev:anchor": "PRODUCT=anchor astro dev",
    "dev:motion": "PRODUCT=motion astro dev",
    "dev:indulge": "PRODUCT=indulge astro dev",
    "build": "node scripts/build-all.mjs",
    "build:one": "astro build",
    "check": "astro check && node scripts/build-all.mjs && node scripts/check-all.mjs",
